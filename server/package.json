{
  "name": "wibby-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "storage:inspect": "node src/scripts/clean-storage.mjs",
    "storage:clean-tests": "node src/scripts/clean-storage.mjs --clean-tests",
    "storage:wipe-all": "node src/scripts/clean-storage.mjs --wipe-all --confirm",
    "storage:verify-encryption": "node src/scripts/verify-encryption.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "multer": "^2.3.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "lamejs": "^1.2.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
