# ==============================================================================
# WIBBY — ZERO-COST (₹0) SERVER ENVIRONMENT CONFIGURATION
# Backend Host: Render Free Web Service
# Database: MongoDB Atlas Free (M0 Tier)
# Auth: Firebase Authentication (Spark Plan)
# ==============================================================================

NODE_ENV=production

# Render automatically sets PORT (usually 10000)
PORT=10000

# Allowed Frontend Origins (Strict CORS)
CLIENT_URL=https://wibby024.web.app,https://wibby024.firebaseapp.com,https://wibby.web.app

# MongoDB Atlas Free (M0 Cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.xxxx.mongodb.net/wibby?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_ATLAS_USER:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/wibby?retryWrites=true&w=majority
MONGODB_DB_NAME=wibby

# Persistent Zero-Cost Media Storage (GridFS in Atlas Free Tier)
STORAGE_PROVIDER=gridfs

# Firebase Admin SDK Credentials (wibby024 Project - Spark ₹0 Plan)
FIREBASE_PROJECT_ID=wibby024
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wibby024.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WebRTC STUN/TURN (Optional Free TURN credentials, e.g. Metered.ca Free Tier)
# Google STUN (stun:stun.l.google.com:19302) is used by default
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
TURN_SHARED_SECRET=
